# Dashboard port. The Web UI listens here; the built-in Hermes dashboard is off.
PORT=8080

# Dashboard credentials (legacy names retained for migration compatibility).
# The same value signs the Web UI login, so an existing deployment keeps its
# password. Left unset, the entrypoint generates one and logs it once at boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: use an independent session-signing secret after migration.
# Changing it logs dashboard users out but does not affect Hermes data.
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ── Hermes Web UI ────────────────────────────────────────────────────────────
# Master switch (1/true/yes) for the community Web UI, nesquena/hermes-webui,
# running beside the gateway in the same container. It replaces the built-in
# dashboard as the browser surface; the dashboard's s6 service stays disabled.
HERMES_WEBUI_ENABLED=1

# Overrides for the Web UI. Unset = derived: the port from PORT, the password
# from ADMIN_PASSWORD.
# HERMES_WEBUI_PORT=8787
# HERMES_WEBUI_PASSWORD=change-me-to-something-strong

# The Web UI's workspace file browser. It lives on the volume, so files the agent
# writes there survive a redeploy and count against the volume quota.
# HERMES_WEBUI_DEFAULT_WORKSPACE=/data/workspace

# Re-enable the built-in dashboard (PORT + basic auth) if you ever need it
# alongside the Web UI. Give it its own port first, or the two collide.
# HERMES_DASHBOARD=1
# HERMES_DASHBOARD_PORT=8081

# Telegram webhook mode (required alongside TELEGRAM_WEBHOOK_URL)
# The adapter's 300s get_me() identity refresh has no env knob; the Dockerfile
# widens it to 3600s so Railway can reach its idle window.
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PORT=8443

# Railway Serverless sleeps on 5 minutes with no outbound packets. Hermes'
# fallback-IP transport sets SO_KEEPALIVE with a 30s idle probe, so one idle
# Bot API socket keeps the service awake forever. Railway has working DNS for
# api.telegram.org, so the fallback path buys nothing here.
HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=true
