# Dashboard port
PORT=8080

# Dashboard credentials (legacy names retained for migration compatibility)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: use an independent session-signing secret after migration.
# Changing it logs dashboard users out but does not affect Hermes data.
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Telegram webhook mode (required alongside TELEGRAM_WEBHOOK_URL)
# The adapter's 300s get_me() identity refresh has no env knob; the Dockerfile
# widens it to 3600s so Railway can reach its idle window.
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PORT=8443

# Railway Serverless sleeps on 5 minutes with no outbound packets. Hermes'
# fallback-IP transport sets SO_KEEPALIVE with a 30s idle probe, so one idle
# Bot API socket keeps the service awake forever. Railway has working DNS for
# api.telegram.org, so the fallback path buys nothing here.
HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=true
